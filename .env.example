FILVAULT_METADATA_STORE=postgres
FILVAULT_OBJECT_STORE=s3
FILVAULT_POSTGRES_PASSWORD=replace-with-local-postgres-password
FILVAULT_S3_ENDPOINT=http://127.0.0.1:9002
FILVAULT_S3_PUBLIC_ENDPOINT=http://127.0.0.1:9002
FILVAULT_S3_BUCKET=filvault
FILVAULT_S3_REGION=us-east-1
FILVAULT_DATABASE_URL=postgres://filvault:replace-with-local-postgres-password@127.0.0.1:5435/filvault?sslmode=disable
FILVAULT_QUEUE=none
FILVAULT_INVITE_CODE=dev-invite
# Dev seed (make seed / Docker FILVAULT_SEED_DEV_USER=true): dev@filvault.com / Dev1234@
# FILVAULT_SEED_DEV_USER=
# FILVAULT_SEED_EMAIL=
# FILVAULT_SEED_PASSWORD=
# FILVAULT_SEED_DISPLAY_NAME=
FILVAULT_MAILER=auto
FILVAULT_SMTP_HOST=
FILVAULT_SMTP_PORT=587
FILVAULT_SMTP_USERNAME=
FILVAULT_SMTP_PASSWORD=
FILVAULT_SMTP_FROM=
FILVAULT_S3_ACCESS_KEY=filvault
FILVAULT_S3_SECRET_KEY=filvaultsecret
FILVAULT_JWT_SECRET=change-me
FILVAULT_HTTP_ADDR=:8080
FILVAULT_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FILVAULT_DEFAULT_TRASH_AUTO_DELETE=false
FILVAULT_DEFAULT_TRASH_RETENTION_DAYS=30
FILVAULT_DEFAULT_IMAGE_THUMBNAILS=true
FILVAULT_DEFAULT_VIDEO_THUMBNAILS=true

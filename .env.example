FILNEST_METADATA_STORE=postgres
FILNEST_OBJECT_STORE=s3
FILNEST_S3_ENDPOINT=http://127.0.0.1:9000
FILNEST_S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
FILNEST_S3_BUCKET=filnest
FILNEST_S3_REGION=us-east-1
FILNEST_DATABASE_URL=postgres://filnest:filnest@127.0.0.1:5432/filnest?sslmode=disable
FILNEST_QUEUE=none
FILNEST_INVITE_CODE=dev-invite
# Dev seed (make seed / Docker FILNEST_SEED_DEV_USER=true): dev@filnest.com / Dev1234@
# FILNEST_SEED_DEV_USER=
# FILNEST_SEED_EMAIL=
# FILNEST_SEED_PASSWORD=
# FILNEST_SEED_DISPLAY_NAME=
FILNEST_MAILER=auto
FILNEST_SMTP_HOST=
FILNEST_SMTP_PORT=587
FILNEST_SMTP_USERNAME=
FILNEST_SMTP_PASSWORD=
FILNEST_SMTP_FROM=
FILNEST_S3_ACCESS_KEY=filnest
FILNEST_S3_SECRET_KEY=filnestsecret
FILNEST_JWT_SECRET=change-me
FILNEST_HTTP_ADDR=:8080
FILNEST_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FILNEST_DEFAULT_TRASH_AUTO_DELETE=false
FILNEST_DEFAULT_TRASH_RETENTION_DAYS=30

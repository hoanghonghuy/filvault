# Copy to .env (gitignored) before `make up` or `docker compose up`.
# Use local-only placeholder values; never commit real secrets.

FILVAULT_METADATA_STORE=postgres
FILVAULT_OBJECT_STORE=s3
FILVAULT_POSTGRES_PASSWORD=replace-with-local-postgres-password
FILVAULT_S3_ENDPOINT=http://127.0.0.1:9002
FILVAULT_S3_PUBLIC_ENDPOINT=http://127.0.0.1:9002
FILVAULT_S3_BUCKET=filvault
FILVAULT_S3_REGION=us-east-1
FILVAULT_DATABASE_URL=postgres://filvault:replace-with-local-postgres-password@127.0.0.1:5435/filvault?sslmode=disable
FILVAULT_QUEUE=none
FILVAULT_INVITE_CODE=replace-with-local-invite-code
FILVAULT_S3_ACCESS_KEY=filvault
FILVAULT_S3_SECRET_KEY=replace-with-local-s3-secret-key
FILVAULT_JWT_SECRET=replace-with-local-jwt-secret-min-32-chars
FILVAULT_HTTP_ADDR=:8080
FILVAULT_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FILVAULT_DEFAULT_TRASH_AUTO_DELETE=false
FILVAULT_DEFAULT_TRASH_RETENTION_DAYS=30
FILVAULT_DEFAULT_IMAGE_THUMBNAILS=true
FILVAULT_DEFAULT_VIDEO_THUMBNAILS=true

# Dev seed (Docker FILVAULT_SEED_DEV_USER=true / make seed): credentials below
FILVAULT_SEED_DEV_USER=true
FILVAULT_SEED_EMAIL=dev@filvault.com
FILVAULT_SEED_PASSWORD=replace-with-local-seed-password
FILVAULT_SEED_DISPLAY_NAME=Filvault Dev

# LiveKit (voice/video calls in local stack)
LIVEKIT_API_KEY=replace-with-local-livekit-api-key
LIVEKIT_API_SECRET=replace-with-local-livekit-api-secret

# Optional: set to LAN IP (e.g. 192.168.1.6) when testing on mobile devices on the same Wi-Fi
# FILVAULT_HOST=localhost

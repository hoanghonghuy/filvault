# Production-like runtime template — copy to deploy/production/.env via generate-env.sh
# or your secret manager. Documented placeholders MUST NOT be used with FILVAULT_ENV=production.

FILVAULT_ENV=production
FILVAULT_PUBLIC_HOST=filvault.local
FILVAULT_PUBLIC_PORT=8443

# Managed Postgres (TLS required; host must not be localhost/127.0.0.1 in real production)
FILVAULT_POSTGRES_PASSWORD=SET_UNIQUE_POSTGRES_PASSWORD
FILVAULT_DATABASE_URL=postgres://filvault:SET_UNIQUE_POSTGRES_PASSWORD@postgres:5432/filvault?sslmode=require

FILVAULT_METADATA_STORE=postgres
FILVAULT_OBJECT_STORE=s3
FILVAULT_S3_ENDPOINT=http://minio:9000
FILVAULT_S3_PUBLIC_ENDPOINT=https://filvault.local:8443/filvault
FILVAULT_S3_BUCKET=filvault
FILVAULT_S3_REGION=us-east-1
FILVAULT_S3_ACCESS_KEY=SET_UNIQUE_S3_ACCESS_KEY
FILVAULT_S3_SECRET_KEY=SET_UNIQUE_S3_SECRET_KEY

FILVAULT_JWT_SECRET=SET_UNIQUE_JWT_SECRET_MIN_32_CHARS
FILVAULT_INVITE_CODE=SET_UNIQUE_INVITE_CODE_MIN_8
FILVAULT_HTTP_ADDR=:8080

# Real SMTP in production — Mailpit is acceptable only for the reference Compose stack
FILVAULT_MAILER=smtp
FILVAULT_SMTP_HOST=mailpit
FILVAULT_SMTP_PORT=1025
FILVAULT_SMTP_FROM=noreply@filvault.local

# Public browser origin (HTTPS). Must match TLS host served by the edge proxy.
FILVAULT_CORS_ALLOWED_ORIGINS=https://filvault.local:8443

# CIDRs of reverse-proxy hops allowed to set X-Forwarded-For (Docker private ranges for Compose)
FILVAULT_TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

FILVAULT_DEFAULT_TRASH_AUTO_DELETE=false
FILVAULT_DEFAULT_TRASH_RETENTION_DAYS=30

# LiveKit: leave keys empty to disable voice/video, or set both with wss:// public URL
# FILVAULT_LIVEKIT_URL=http://livekit:7880
# FILVAULT_LIVEKIT_PUBLIC_URL=wss://filvault.local:8443
# FILVAULT_LIVEKIT_API_KEY=
# FILVAULT_LIVEKIT_API_SECRET=

FILVAULT_SEED_DEV_USER=false
GIN_MODE=release
